PORT=3022
# 0.0.0.0 = accesible en LAN (celular). localhost = solo esta PC.
HOST=0.0.0.0
NODE_ENV=production

JWT_SECRET=change-me
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=7d

BUSINESS_TIMEZONE=America/Mexico_City

API_WHATS=https://api-wa-sendings.gsanmartin.net/api/message/
WHATSAPP_ORIGIN_ID=1
WHATSAPP_NIP_EXPIRE_MINUTES=5

# Ticket de pago (mismo flujo que api-recibodigital-nest)
API_SMS=https://gsm-it.app.n8n.cloud/webhook/api/send
API_OMNI=http://localhost:3001/
API_STORAGE=http://localhost:3013/
S3_ROUTE=https://gsm-storage-beta.sfo3.cdn.digitaloceanspaces.com/

DB_HOST=localhost
DB_USR=postgres
DB_PORT=5432
DB_PSW=secret
DB_NAME=odoo-gsm
DB_SYNC=false
# true en DigitalOcean Managed Postgres (TLS obligatorio)
DB_SSL=false

# api-odoo-gsm (búsqueda de planes)
API_ODOO_GSM_URL=http://127.0.0.1:3006

# Clave para que Odoo (Mesa de Control → Conciliación) consulte ventas
# Header: X-Api-Key: <valor>
ODOO_API_KEY=change-me-odoo-conciliation

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_NAME=Administrador Venta Digital

# Google Drive (documentos de ventas)
GOOGLE_DRIVE_FOLDER_ID=
# OAuth (prioridad si hay CLIENT_ID + SECRET + refresh token)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3022/api/drive/oauth/callback
GOOGLE_OAUTH_REFRESH_TOKEN=
# Service Account (fallback / prod): JSON completo en una línea
GOOGLE_SERVICE_ACCOUNT_JSON=
